# Monomial cuártico de CONTROL (n = 4): V(phi) = A |phi|^4 = (lambda_eff/4) phi^4, con el lambda_eff del
# T-model cuártico (alpha_K = 1). No es un modelo del paper: phi^4 puro predice n_s = 0.946 y r = 0.29
# para N_* = 55, excluido por r < 0.036. Sirve para aislar el efecto del plateau del T/E-model: cerca
# del mínimo tiene el mismo potencial de programa (phi~^4/4 + q phi~^2 chi~^2/2) y, con el mismo q, el
# mismo acople físico g = sqrt(q lambda_eff). Es equivalente a lphi4 con lambda = lambda_eff.
# Parámetros recalculados por code/parametros_cuarticos.py::monomial_control. omega_* = 2.51e13 GeV.
# Explicación de cada parámetro y de cómo correrlo: Notas.tex Sec. 7.

#Output
outputfile = ./
print_headers = true
overwriteFiles = false

#Evolution
expansion = true
evolver = VV2

#Lattice
# Igual que los otros .in cuárticos (Notas.tex Sec. 6): para N mayor, kIR = 0.7*64/N y dt = 0.01.
N = 64
dt = 0.01
kIR = 0.7

#Times
# Con N = 32 el campo hijo satura en t~ ~ 80 y rho_GW/rho llega al 90% de su valor final en t~ ~ 230
# (antes que en el T/E-model); tMax = 500 deja la misma ventana que el T-model para comparar.
tOutputFreq = 0.2
tOutputInfreq = 10
tOutputRareFreq = 50
tMax = 500

#Power spectrum options
PS_type = 1
PS_version = 1

#IC
kCutOff = 18
# initial_amplitudes[0] = phi_0 = (sqrt(2)/2) n m_p (epsilon_V = 1, Notas.tex Sec. 1.4)
# initial_momenta[0] = -sqrt((sqrt(7/3) - 1) * A phi_0^4) (slow-roll, Notas.tex Sec. 1.5)
initial_amplitudes = 6.88722e18 0  # homogeneous amplitudes in GeV
initial_momenta = -6.2899e31 0     # homogeneous momenta in GeV^2

#Model Parameters
# A = lambda_eff/4, lambda_eff = 4 A_T/M_T^4 = 1.3333e-11 (T-model, alpha_K = 1); m_p = 2.435e18 GeV.
n = 4
A = 3.33322e-12
q = 120

#GWs
withGWs = true
GWprojectorType = 1
