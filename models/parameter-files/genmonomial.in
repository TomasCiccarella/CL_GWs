#Output
outputfile = ./
print_headers = true
overwriteFiles = false

#Evolution
expansion = true
evolver = VV2

#Lattice
N = 64
dt = 0.001
kIR = 3

#Times
tOutputFreq = 0.1
tOutputInfreq = 1
tOutputRareFreq = 10
tMax = 20

#IC
kCutOff = 18
# initial_amplitudes[0] = phi_0 = (sqrt(2)/2) * n * m_p (epsilon_V = 1, Notas/Notas.tex Sec. 1.4)
# initial_momenta[0] = -sqrt((sqrt(7/3) - 1) * V(phi_0)) (slow-roll, Notas/Notas.tex Sec. 1.5).
# With m_p = 2.435e18 GeV and n, A below. Recomputed by code/verificar_genmodels.py.
initial_amplitudes = 1.03308e19 0  # homogeneous amplitudes in GeV
initial_momenta = -3.0632e31 0     # homogeneous momenta in GeV^2

#Model Parameters
# V(phi) = A |phi|^n (the 1/n only appears in the program potential). A below is illustrative
# (chosen only so that omega_* ~ 1e13 GeV, the same order of magnitude as in lphi4.in/tanh2.in):
# for a physical run, fix it from the observed CMB amplitude for your chosen n.
n = 6
A = 1.4632e-51
# n = 6 > 4: the gradient term and the daughter-field mass grow in program time (Notas.tex
# Sec. 1.6), so dt, q and tMax are tied together. With N = 64, kIR = 3, dt = 0.001 and q = 1e2
# the run blows up at a ~ 290 (t ~ 27); tMax = 20 (a ~ 190) leaves margin. With q = 4e4 and
# dt = 0.005 it blows up already at t ~ 0.5. If you change n, q, dt, N or kIR, recompute the
# bound with code/verificar_genmodels.py::cotas_estabilidad.
q = 1e2

#GWs
withGWs=false
GWprojectorType = 1
